# Copy this file to .env (git-ignored) and fill in real values. Never commit .env.
#
# DB_CONNECTION_STRING: the Azure SQL connection string. Copy the value from the
# Key Vault secret in Kv-customappsdemo. Server: devportalsqlserver.database.windows.net
DB_CONNECTION_STRING=Server=tcp:devportalsqlserver.database.windows.net,1433;Database=<database-name>;User ID=<user>;Password=<password>;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;

# JWT_SECRET: a random string of at least 32 characters, used to sign the login cookie.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=<at-least-32-random-characters>

# PORT for the local API server (Vite proxies to it). Azure sets PORT itself.
PORT=3001
